 "draft": {
  "title": "NATRON'S SHIMMER",
  "feature_km": 57,
  "hooks": [
   {
    "text": "A shallow lake spans fifty‑seven kilometres, yet its chemistry shouldn't sparkle so intensely.",
    "title": "ALKA PUZZLE"
   },
   {
    "text": "A bright lake stretches fifty‑seven kilometres, and its surface shouldn't glimmer this way.",
    "title": "SHIMMER FACT"
   },
   {
    "text": "A long lake covers fifty‑seven kilometres, and its water shouldn't be this alkaline.",
    "title": "ALKA RIFT"
   }
  ],
  "beats": [
   {
    "text": "A long lake covers fifty-seven kilometres, and its water shouldn't be this alkaline.",
    "shot": "feature",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "So why does this shallow lake shine with a crystal-like surface?",
    "shot": "close",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "And the middle hides one more surprise.",
    "shot": "wide",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "From orbit the lake stretches like a long ribbon across the rift.",
    "shot": "wide",
    "overlay": {
     "type": "ruler",
     "on": "lake",
     "label": "57 KM"
    },
    "react": null,
    "photo": {
     "index": 0,
     "label": "Lake Natron view",
     "on": "lake"
    }
   },
   {
    "text": "Washington would fit inside it, and it is about three times as wide as Washington.",
    "shot": "close",
    "overlay": {
     "type": "scale",
     "on": "Washington"
    },
    "react": null,
    "photo": null
   },
   {
    "text": "Sodium carbonate from evaporating water builds up, raising the lake's pH.",
    "shot": "close",
    "overlay": {
     "type": "highlight",
     "on": "Sodium"
    },
    "react": null,
    "photo": null
   },
   {
    "text": "Mineral-rich hot springs add more salts, keeping the water intensely alkaline.",
    "shot": "close",
    "overlay": {
     "type": "tag",
     "on": "hot",
     "label": "SPRINGS"
    },
    "react": null,
    "photo": null
   },
   {
    "text": "It sits within the Gregory Rift, the eastern arm of the East African Rift.",
    "shot": "wide",
    "overlay": {
     "type": "stamp",
     "on": "Gregory",
     "label": "RIFT"
    },
    "react": {
     "expr": "surprised",
     "on": "Gregory"
    },
    "photo": null
   },
   {
    "text": "Next target: a circular sinkhole over three hundred metres wide. Follow for the next scan. Orbi out.",
    "shot": "space",
    "overlay": null,
    "react": {
     "expr": "happy",
     "on": "sinkhole"
    },
    "photo": null
   }
  ],
