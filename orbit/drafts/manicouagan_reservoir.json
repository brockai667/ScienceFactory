{
 "draft": {
  "title": "MANICOUAN RING",
  "feature_km": 70,
  "hooks": [
   {
    "text": "This perfect ring is seventy kilometers wide, and a scar shouldn't appear here.",
    "title": "GIGANTIC CIRCLE"
   },
   {
    "text": "An eye of Quebec spans seventy kilometers, and it never blinked.",
    "title": "COSMIC GAZE"
   },
   {
    "text": "Why does this ring measure seventy kilometers, when no volcano made it?",
    "title": "CRATER PUZZLE"
   }
  ],
  "beats": [
   {
    "text": "An eye of Quebec spans seventy kilometers, and it never blinked.",
    "shot": "feature",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "So what carved a perfect ring into Quebec?",
    "shot": "close",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "And the middle hides one more surprise.",
    "shot": "close",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "From orbit the ring looks like a giant eye, and Greater London would fit inside.",
    "shot": "wide",
    "overlay": {
     "type": "scale",
     "on": "Greater"
    },
    "react": null,
    "photo": {
     "index": 0,
     "label": "From the ISS",
     "on": "orbit"
    }
   },
   {
    "text": "The outer crater is about one hundred kilometers across.",
    "shot": "wide",
    "overlay": {
     "type": "ruler",
     "on": "crater",
     "label": "100 KM"
    },
    "react": null,
    "photo": null
   },
   {
    "text": "Two hundred fourteen million years ago a meteor slammed here.",
    "shot": "close",
    "overlay": {
     "type": "stamp",
     "on": "meteor",
     "label": "214 MYA"
    },
    "react": {
     "expr": "surprised",
     "on": "meteor"
    },
    "photo": null
   },
   {
    "text": "The impactor was five kilometers wide, carving the concentric basin we see.",
    "shot": "close",
    "overlay": {
     "type": "highlight",
     "on": "five"
    },
    "react": null,
    "photo": null
   },
   {
    "text": "It holds about one hundred thirty eight cubic kilometers of water, a massive hidden volume.",
    "shot": "wide",
    "overlay": {
     "type": "tag",
     "on": "water",
     "label": "VOLUME"
    },
    "react": {
     "expr": "happy",
     "on": "water"
    },
    "photo": null
   },
   {
    "text": "Next target: the farthest point from any coastline on a continent. Follow for the next scan. Orbi out.",
    "shot": "space",
    "overlay": null,
    "react": null,
    "photo": null
   }
  ],
  "description": "Manicouagan Reservoir is a seventy‑kilometer‑wide annular lake formed by a meteor impact two hundred fourteen million years ago. It holds about one hundred thirty eight cubic kilometers of water.",
