  "beats": [
   {
    "text": "This ring survived two hundred fourteen million years, yet looks fresh.",
    "shot": "feature",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "So what carved this perfect circle into the ancient forest?",
    "shot": "close",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "And the centre hides one more surprise waiting for you.",
    "shot": "close",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "From orbit the ring looks like a giant eye, perfectly round.",
    "shot": "wide",
    "overlay": {
     "type": "ruler",
     "on": "ring",
     "label": "70 KM"
    },
    "react": null,
    "photo": {
