     "on": "ring"
    }
   },
   {
    "text": "Greater London would fit inside its full span.",
    "shot": "wide",
    "overlay": {
     "type": "scale",
     "on": "Greater",
     "label": "Greater London"
    },
    "react": null,
    "photo": null
   },
   {
    "text": "A five kilometer meteor struck here in the Late Triassic, shaping the basin.",
    "shot": "close",
    "overlay": {
     "type": "stamp",
     "on": "meteor",
     "label": "Late Triassic"
    },
    "react": {
     "expr": "surprised",
     "on": "meteor"
    },
    "photo": null
   },
   {
    "text": "The impact shattered rock, forming multiple rings that later filled with water.",
    "shot": "close",
    "overlay": {
     "type": "highlight",
     "on": "rings"
    },
    "react": null,
    "photo": null
   },
   {
    "text": "It still holds about one hundred thirty eight cubic kilometres of crystal water.",
    "shot": "wide",
    "overlay": {
