  "beats": [
   {
    "text": "One in three plants on this island grows nowhere else on Earth.",
    "shot": "feature",
    "overlay": null,
    "react": null,
    "photo": null
   },
   {
    "text": "What cut them off from the rest of the world?",
    "shot": "close",
    "overlay": null,
    "react": null,
    "photo": {
     "index": 1,
     "label": "DRAGON'S BLOOD TREE",
     "on": "world"
